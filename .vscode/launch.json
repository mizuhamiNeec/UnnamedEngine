{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EngineDebug",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Debug-windows-x86_64/UnnamedEditorApp/UnnamedEditorApp.exe",
      "args": ["--project=projects/ParkourGame/config/game_profile.json"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "build"
    },
    {
      "name": "EngineRelease",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Release-windows-x86_64/UnnamedLauncher/UnnamedLauncher.exe",
      "args": ["--project=projects/ParkourGame/config/game_profile.json"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "build-release"
    }
  ]
}